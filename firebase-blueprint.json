{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "User productivity task item",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 5000 },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["todo", "in_progress", "completed"] },
        "category": { "type": "string", "maxLength": 100 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "estimatedMinutes": { "type": "number" },
        "reminderTime": { "type": "string", "maxLength": 30 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "priority", "status", "category", "dueDate"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "User scheduled calendar event",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 5000 },
        "date": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "location": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "maxLength": 50 },
        "googleEventId": { "type": "string", "maxLength": 255 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "date", "startTime", "endTime"]
    },
    "Note": {
      "title": "Note",
      "description": "User knowledge note or draft",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 50000 },
        "category": { "type": "string", "maxLength": 100 },
        "pinned": { "type": "boolean" },
        "userId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "content"]
    }
  },
  "firestore": {
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks stored per authenticated user"
    },
    "/users/{userId}/events/{eventId}": {
      "schema": "CalendarEvent",
      "description": "User calendar events stored per authenticated user"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "User notes stored per authenticated user"
    }
  }
}
