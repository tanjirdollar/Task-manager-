rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default-deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Healthcheck / Connection test
    match /test/{docId} {
      allow read: if true;
    }

    // Shared Workspace for real-time collaboration and multi-browser synchronization
    match /workspaces/{workspaceId} {
      allow read, write: if true;

      match /tasks/{taskId} {
        allow read, write: if true;
      }

      match /events/{eventId} {
        allow read, write: if true;
      }

      match /notes/{noteId} {
        allow read, write: if true;
      }

      match /settings/{settingId} {
        allow read, write: if true;
      }
    }

    // Per-user subcollections (Tasks, Events, Notes, Settings)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      match /events/{eventId} {
        allow read, write: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
